OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Server Functions only. Put real values in Netlify's secrets UI, never in Git.
ADMIN_MASTER_CODE=
ADMIN_SESSION_SECRET=
SUPABASE_URL=https://chffnolrtxfoehegnecj.supabase.co
SUPABASE_SECRET_KEY=

# Optional emergency switch. false skips paid AI; existing DB reading remains.
AI_READING_ENABLED=true
# Staged migration only. Do NOT enable until server member login/data paths are ready.
AI_REQUIRE_MEMBER_SESSION=false
# Independent random server secret. Never reuse ADMIN_SESSION_SECRET or a password.
MEMBER_SESSION_SECRET=

# Optional ADMIN-ONLY rehearsal, NOT the normal user login. Leave disabled until
# deploying/testing the new endpoints. No public production mode is implemented.
MEMBER_ACCESS_MODE=disabled
# Explicit test account IDs only, comma-separated. Empty fails closed.
MEMBER_REHEARSAL_IDS=
# Independent write opt-in, only AFTER isolated SQL tests and explicit DB approval.
# Do not enable while legacy public whole-row writers remain in use.
MEMBER_ARCHIVE_WRITE_MODE=disabled
# Separate opt-in for member messages AND admin replies. Isolated tests first.
MEMBER_CONSULT_WRITE_MODE=disabled
# Registration/admin edits stay disabled until isolated tests + coordinated cutover.
MEMBER_ACCOUNT_WRITE_MODE=disabled
# User-confirmed policy, 2026-10-15: immediate permanent Member (never admin).
MEMBER_SIGNUP_POLICY=instant-permanent
